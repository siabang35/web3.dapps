# Ignore node_modules for all subprojects
**/node_modules/

# Ignore environment files
**/.env

# Ignore build artifacts (e.g., from Hardhat or similar tools)
**/artifacts/
**/cache/
**/typechain-types/

# Ignore logs
*.log

# Ignore system-specific files
.DS_Store
Thumbs.db

# Ignore compiled TypeScript files (if applicable)
**/*.tsbuildinfo

# Ignore coverage reports
coverage/

# Ignore dist or build directories
dist/
build/
